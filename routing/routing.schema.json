{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-playbook routing table",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tiers", "writer_roles", "writer_forbidden_tiers", "session_tiers_accepted", "profiles"],
  "$defs": {
    "tier": { "enum": ["economy", "standard", "premium", "flagship"] },
    "classRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowed"],
      "properties": {
        "default": { "$ref": "#/$defs/tier" },
        "allowed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tier" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "class_aliases"],
      "properties": {
        "classes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/classRule" } },
        "class_aliases": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "standard", "premium", "flagship"],
      "patternProperties": {
        "^(economy|standard|premium|flagship)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "model_id", "pin_env"],
          "properties": {
            "alias": { "type": "string", "description": "Alias que acepta el parámetro model del Agent tool." },
            "model_id": { "type": "string", "description": "Identificador exacto al que debería apuntar el alias." },
            "pin_env": { "type": "string", "description": "Variable de entorno que fija el alias a model_id." },
            "runtime_aliases": {
              "type": "object",
              "additionalProperties": false,
              "description": "Mapeo multi-runtime (Claude Code y Google Antigravity agy).",
              "properties": {
                "claude": { "type": "string" },
                "agy": { "type": "string" },
                "model_ids": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "writer_roles": { "type": "array", "items": { "type": "string" } },
    "writer_forbidden_tiers": { "type": "array", "items": { "$ref": "#/$defs/tier" } },
    "session_tiers_accepted": { "type": "array", "items": { "$ref": "#/$defs/tier" } },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced", "full"],
      "properties": {
        "reduced": { "$ref": "#/$defs/profile" },
        "full": { "$ref": "#/$defs/profile" }
      }
    }
  }
}
